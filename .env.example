# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it holds secrets for your machine only.

# Django signs cookies/tokens with this. Generate a long random string for each environment.
SECRET_KEY=replace-me-with-a-long-random-string

# True for local development. Must be False in production.
DEBUG=True

# Comma-separated hostnames Django will accept.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Local SQLite file name (relative to backend/).
SQLITE_PATH=db.sqlite3

# Zambia local time for lesson scheduling later.
TIME_ZONE=Africa/Lusaka

# Frontend origins allowed to call this API in the browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Email (console backend prints to the terminal in local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@roadstar.local

# Used to build password-reset links in emails
FRONTEND_URL=http://localhost:3000
